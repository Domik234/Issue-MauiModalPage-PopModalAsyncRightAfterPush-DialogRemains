<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModalRaceRepro.MainPage">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label x:Name="Status" Text="Tap a button" />
        <Button Text="Push modal + immediate Pop (animated: false)" Clicked="OnImmediate" />
        <Button Text="Push modal, wait 1000 ms, Pop (control)" Clicked="OnDelayed" />
    </VerticalStackLayout>
</ContentPage>
